{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true, "jsx": "react-jsx", "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["apps/server/**/*.ts", "apps/worker/**/*.ts", "apps/admin/**/*", "packages/**/*.ts", "tools/**/*.ts", "tests/**/*.ts", "database/*.ts"],
  "exclude": ["node_modules"]
}
